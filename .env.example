# Скопируй этот файл в .env и заполни своими значениями:
#   copy .env.example .env

# Токен бота от @BotFather в Telegram (обязательно)
BOT_TOKEN=

# Прокси, если api.telegram.org недоступен напрямую (необязательно)
# Формат: socks5://user:pass@host:port  или  http://host:port
PROXY_URL=

# Telegram ID администратора — для доступа к админке (необязательно)
# Узнать свой ID можно у @userinfobot
ADMIN_ID=
